# CineBot ortam ayarları. Bu dosyayı .env olarak kopyalayın ve anahtarları doldurun.
APP_NAME="CineBot API"
APP_ENV="development"
DEBUG=true

# Sunucu
HOST="0.0.0.0"
PORT=8000
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000"

# Veri ve vektör araması
HF_DATASET_NAME="Ashaq2004/tmdb-movies"
HF_FALLBACK_DATASET_NAME="Pablinho/movies-dataset"
EMBEDDING_MODEL_NAME="paraphrase-multilingual-MiniLM-L12-v2"
MAX_DATASET_ROWS=5000
DEFAULT_TOP_K=5

# Dil modeli: groq | gemini | openai | auto
LLM_PROVIDER="groq"
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
LLM_TEMPERATURE=0.4
